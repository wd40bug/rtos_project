#include <Wire.h>

// ===========================================
// INA219 ADDRESSES
// ===========================================
#define INA1_ADDR 0x41
#define INA2_ADDR 0x40

// INA219 Registers
#define REG_CONFIG     0x00
#define REG_SHUNT      0x01
#define REG_BUS        0x02
#define REG_POWER      0x03
#define REG_CURRENT    0x04
#define REG_CALIB      0x05

// ===========================================
// I2C BUSES
// ===========================================
// Nucleo L476RG:
//   I2C1 = PB7 (SDA), PB6 (SCL)
//   I2C2 = PB11 (SDA), PB10 (SCL)
TwoWire Wire1(PB9, PB8);     // INA219 @ 0x40
TwoWire Wire2(PB11, PB10);   // INA219 @ 0x41

// ===========================================
// I2C HELPERS
// ===========================================
void i2cWrite16(TwoWire &bus, uint8_t addr, uint8_t reg, uint16_t value) {
    bus.beginTransmission(addr);
    bus.write(reg);
    bus.write((value >> 8) & 0xFF);
    bus.write(value & 0xFF);
    bus.endTransmission();
}

uint16_t i2cRead16(TwoWire &bus, uint8_t addr, uint8_t reg) {
    bus.beginTransmission(addr);
    bus.write(reg);
    bus.endTransmission();   // Restart, no stop
    bus.requestFrom(addr, (uint8_t)2);

    uint16_t value = (bus.read() << 8) | bus.read();
    return value;
}

// ===========================================
// INA219 CONVERSIONS
// ===========================================
float readShuntVoltage_mV(TwoWire &bus, uint8_t addr) {
    int16_t raw = (int16_t)i2cRead16(bus, addr, REG_SHUNT);
    return raw * 0.01f;  // 10uV per bit
}

float readBusVoltage_V(TwoWire &bus, uint8_t addr) {
    uint16_t raw = i2cRead16(bus, addr, REG_BUS);
    raw >>= 3;            // remove flags
    return raw * 0.004f;  // 4mV per bit
}

float readCurrent_mA(TwoWire &bus, uint8_t addr) {
    int16_t raw = (int16_t)i2cRead16(bus, addr, REG_CURRENT);
    return raw * 0.0305f; // 30.5uA per bit
}

// ===========================================
// SETUP
// ===========================================
void setup() {
    Serial.begin(115200);
    delay(500);

    Serial.println("\n=== Dual INA219 on I2C1 + I2C2 ===");

    // Start both buses at 400 kHz
    Wire1.begin();
    Wire1.setClock(400000);

    Wire2.begin();
    Wire2.setClock(400000);

    // Standard config for continuous measurements
    uint16_t config = 0x399F;
    uint16_t calib  = 13400;

    // Init INA1 (0x40)
    i2cWrite16(Wire1, INA1_ADDR, REG_CONFIG, config);
    i2cWrite16(Wire1, INA1_ADDR, REG_CALIB,  calib);

    // Init INA2 (0x41)
    i2cWrite16(Wire2, INA2_ADDR, REG_CONFIG, config);
    i2cWrite16(Wire2, INA2_ADDR, REG_CALIB,  calib);

    Serial.println("INA219 sensors initialized.\n");
}

// ===========================================
// LOOP — 1 kHz sampling
// ===========================================
void loop() {
    // Read INA1 (0x40)
    float s1 = readShuntVoltage_mV(Wire1, INA1_ADDR);
    float b1 = readBusVoltage_V(Wire1, INA1_ADDR);
    float c1 = readCurrent_mA(Wire1, INA1_ADDR);

    // Read INA2 (0x41)
    float s2 = readShuntVoltage_mV(Wire2, INA2_ADDR);
    float b2 = readBusVoltage_V(Wire2, INA2_ADDR);
    float c2 = readCurrent_mA(Wire2, INA2_ADDR);

    // Print results
    Serial.println("======================================");

    Serial.println("[Sensor 1 @ 0x41]");
    Serial.print("Shunt Voltage: "); Serial.print(s1, 3); Serial.println(" mV");
    Serial.print("Bus Voltage:   "); Serial.print(b1, 3); Serial.println(" V");
    Serial.print("Current:       "); Serial.print(c1, 3); Serial.println(" mA");

    Serial.println("\n[Sensor 2 @ 0x40]");
    Serial.print("Shunt Voltage: "); Serial.print(s2, 3); Serial.println(" mV");
    Serial.print("Bus Voltage:   "); Serial.print(b2, 3); Serial.println(" V");
    Serial.print("Current:       "); Serial.print(c2, 3); Serial.println(" mA");

    Serial.println("======================================\n");

    delay(1); // 1ms = 1 kHz
}
